APP_NAME="點數充值 DEMO"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost:8443
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=zh_TW
APP_TIMEZONE=Asia/Taipei

LOG_CHANNEL=daily
LOG_LEVEL=info
# 日誌保留天數
LOG_DAILY_DAYS=30
LOG_SECURITY_DAYS=90

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=topup
# 應用程式平常使用的帳號：只有讀寫權限（由 migration 建立）。
DB_USERNAME=topup_app
DB_PASSWORD=
# 資料表擁有者：只給 migration 使用（--database=pgsql_owner），也是 PostgreSQL 容器的管理帳號。
DB_OWNER_USERNAME=topup
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database

# 伺服器間 API（內部網路）
INTERNAL_API_URL=http://web
GAME_API_SECRET=
TOPUP_API_SECRET=
MOCK_GATEWAY_SECRET=

# 後台
ADMIN_IP_ALLOWLIST=127.0.0.1,::1,172.28.0.1
REVIEW_OVERDUE_HOURS=72

# 郵件一律寄到本機 Mailpit（http://localhost:8025），不會寄到外部
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@topup-demo.test
MAIL_FROM_NAME="點數充值 DEMO 客服"
SUPPORT_INBOX=support@topup-demo.test
